# ---- AI图书馆 项目根 .gitignore ----
# 注意：公开仓库默认不包含个人知识库内容与本地数据

# 本地数据（SQLite / LanceDB / 日志）
data/
*.db
*.db-shm
*.db-wal
__pycache__/
*.pyc
.venv/
venv/
*.log
server_log.txt
server_run*.log

# 个人知识库内容（vault 只放模板/占位，不放真实笔记）
# 注意：排除父目录后无法用 ! 重新包含子文件，需用 vault/* 再白名单
vault/*
!vault/README.md
!vault/schema.md

# 采购候选 / 对话归档 / 档案馆（可能含隐私）
pending/
conversations/
archive/

# 密钥与本地配置
secrets.json
*.secret
.env
"server_log.txt"

# ---- P5-1 桌面壳 ----
# PyInstaller 打包产物（build/、dist/、spec）不入库
build/
dist/
*.spec
# 桌面壳运行时生成的文件（图标/日志）
desktop/icon.ico
desktop/*.log
